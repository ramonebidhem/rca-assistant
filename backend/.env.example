# PostgreSQL connection string
DATABASE_URL="postgresql://defautheque:defautheque@localhost:5432/defautheque?schema=public"

# JWT signing secret — CHANGE THIS in production
JWT_SECRET="change-this-jwt-secret-in-production"
JWT_EXPIRES_IN="12h"

# API server
PORT=4000

# Directory (absolute or relative to backend/) where uploaded images are written
UPLOAD_DIR="../uploads"

# Comma-separated list of allowed CORS origins (frontend URL)
CORS_ORIGIN="http://localhost:5173"
